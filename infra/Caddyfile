# infra/Caddyfile — 백엔드 앞단 TLS 종단.
#
# 여기서 하는 일은 하나입니다: HTTPS로 받아서 compose 네트워크의 backend:8000으로 넘깁니다.
# 인증서 발급·갱신은 Caddy가 자동으로 하므로 certbot 타이머나 갱신 스크립트가 없습니다.
#
# ⚠️ 정적 파일을 여기에 얹지 마세요. 프론트는 정적 호스팅으로 나갑니다(ADR-0008).
#    이 프록시에 dist/를 붙이는 순간 배포처가 둘에서 하나로 바뀌는 결정이 되고,
#    그건 ADR-0008의 "재검토 조건"을 먼저 확인해야 하는 사안입니다.
#
# ⚠️ ai-engine을 여기에 라우팅하지 마세요. /v1/generate·/v1/answer는 인증이 없고
#    취약계층 프로필을 받습니다(ADR-0006). 백엔드만 지나갑니다.

{$SAVERS_PUBLIC_HOST} {
	# 압축은 프록시 단에서 겁니다. 대상 사용자의 기본 조건이 구형 단말 + 혼잡 회선이라
	# 응답 크기가 알림 도달 시간에 그대로 들어갑니다.
	encode zstd gzip

	# /internal/* 은 외부에서 불릴 일이 없는 경로라 프록시 이전에 끊습니다.
	# 이게 없으면 포트를 닫아도 소용이 없습니다 — 8000은 127.0.0.1 바인딩이라 막혀 있지만
	# 같은 엔드포인트가 이 프록시를 통해 443으로 그대로 공개됩니다. 리허설 VM에서
	# `POST /internal/alerts/dispatch`가 200을 돌려주는 것을 실제로 확인했습니다(이슈 #25).
	#
	# 인증을 붙이는 대신 차단하는 이유: 이 경로의 호출자는 VM 안의 스케줄러뿐이고
	# 외부 호출자가 존재하지 않습니다. 인증은 키 발급·보관·회수가 따라오지만 차단은
	# 관리 요소가 늘지 않습니다. 외부에서 부를 필요가 생기면 그때 인증을 설계하세요.
	#
	# 403이 아니라 404인 이유: 403은 "여기 뭔가 있는데 막혔다"를 알려줍니다.
	# 없는 것처럼 보이는 편이 낫습니다.
	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy backend:8000 {
			# 백엔드가 자기 자신을 어떤 주소로 불렸는지 알아야 하는 경우를 위해 넘깁니다.
			header_up X-Forwarded-Host {host}
		}
	}

	# 접근 로그를 남깁니다 — 알림 도달 속도는 로그 기반 계측이 원칙이고(AGENTS.md),
	# 프록시 구간 지연은 여기 말고 볼 곳이 없습니다.
	log {
		output stdout
		format console
	}
}
