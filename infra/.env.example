# infra/.env.example — 실제 값이 아닌 "키 목록" 템플릿입니다. 이 파일만 커밋합니다.
# 사용: cp infra/.env.example infra/.env  후 값 입력 (infra/.env 는 커밋 금지)

# ── 생성 모델 (HyperCLOVA X) ─────────────────────────────
CLOVA_API_KEY=
CLOVA_API_GATEWAY_URL=

# ── 벡터 DB (Chroma) ────────────────────────────────────
CHROMA_PERSIST_DIR=./.chroma

# 검색 백엔드 스위치. "fixture"(기본값) | "chroma"
# ⚠️ "chroma"로 켜려면 ai-engine에 `rag` extra가 설치돼 있고, 아래 컬렉션이 이미
#    build_index.py로 색인돼 있어야 합니다 — 그렇지 않으면 모든 요청이 조용히
#    no_evidence로 거부됩니다. apps/ai-engine/src/ai_engine/config.py 참고.
RETRIEVER_BACKEND=fixture

# ── 공공 재난 데이터 Open API ────────────────────────────
# 기상청 / 소방청 / 행정안전부 재난안전데이터 공유 플랫폼
DISASTER_API_KEY=

# ── 국민행동요령 코퍼스 API (safetydata.go.kr, DSSP-IF-20588) ───────────
# DISASTER_API_KEY와는 별도로 발급된 서비스키입니다(AI/RAG 담당 신청).
# ⚠️ safety_cate를 생략하면 API가 조용히 태풍(01001)으로 스코프를 좁힙니다 — 항상
#    명시적으로 지정하세요. apps/ai-engine/src/ai_engine/ingestion.py 참고.
ACTION_MANUAL_API_KEY=

# ── 위치 처리 (카카오맵 역지오코딩) ──────────────────────
KAKAO_REST_API_KEY=

# ── 발송 채널 (웹푸시 / FCM) ─────────────────────────────
# 카카오 알림톡은 예선 범위에서 제외됐습니다(ADR-0005) — 관련 키를 되살리지 마세요.
# FCM Admin SDK 서비스 계정 JSON 경로. 배포 VM에만 존재하며 저장소에 넣지 않습니다.
FCM_SERVICE_ACCOUNT_JSON=

# ── 백엔드 설정 (backend_core.config.Settings — SAVERS_ 접두어 필수) ──
# ⚠️ 접두어 없는 이름으로 두면 코드가 읽지 못하고 조용히 기본값으로 동작합니다.
#    (compose가 서비스 환경변수로 직접 주입하므로 아래 값은 단독 실행용입니다)
SAVERS_AI_ENGINE_URL=http://ai-engine:8100

# ai-engine 호출 타임아웃(초). ⚠️ 8.0은 추정값 — 도달 속도 30초 목표 안에서 실측 후
# 재산정하세요(ADR-0006). 무한 대기는 그 자체로 지표 실패입니다.
SAVERS_AI_ENGINE_TIMEOUT_S=8.0

# 세션 토큰 수명(초). 기본 6시간 — 열람·응답·보호자 재진입은 견디되 유출 링크는 당일 만료.
SAVERS_SESSION_TTL_S=21600

# 푸시 딥링크 오리진(PWA 랜딩). 배포에서는 HTTPS 필수입니다 — 웹푸시는 localhost 외
# HTTPS에서만 동작합니다(ADR-0005).
SAVERS_PUBLIC_BASE_URL=http://localhost:5173
