# infra/.env.example — 실제 값이 아닌 "키 목록" 템플릿입니다. 이 파일만 커밋합니다.
# 사용: cp infra/.env.example infra/.env  후 값 입력 (infra/.env 는 커밋 금지)

# ── 생성 모델 (HyperCLOVA X) ─────────────────────────────
CLOVA_API_KEY=
CLOVA_API_GATEWAY_URL=

# ── 벡터 DB (Chroma) ────────────────────────────────────
CHROMA_PERSIST_DIR=./.chroma

# 검색 백엔드 스위치. "fixture"(기본값) | "chroma"
# ⚠️ "chroma"로 켜려면 ai-engine에 `rag` extra가 설치돼 있고, 아래 컬렉션이 이미
#    build_index.py로 색인돼 있어야 합니다 — 그렇지 않으면 모든 요청이 조용히
#    no_evidence로 거부됩니다. apps/ai-engine/src/ai_engine/config.py 참고.
RETRIEVER_BACKEND=fixture

# ChromaRetriever가 읽을 컬렉션 이름. ⚠️ 반드시 build_index.py --collection과 같아야
# 합니다 — 값을 빈 문자열로 두면(지우면) 빈 컬렉션에 조용히 연결됩니다. 아래 기본값
# "flood_action_manual"이 실제로 색인된 이름이니, 다른 컬렉션을 쓸 게 아니면 지우지 마세요.
ACTION_MANUAL_COLLECTION=flood_action_manual

# ── 재난안전데이터공유플랫폼 ─────────────────────────────
# 데이터셋마다 키가 다릅니다. 전 키 만료 2027-07-27, 키당 일 1000건.
# ⚠️ 값 뒤에 주석을 붙이지 마세요 — `KEY=값 # 주석`은 `#` 이후까지 값에 섞여 들어가고,
#    증상이 인증 실패로만 나타나 원인을 찾기 어렵습니다.
# 긴급재난문자 DSSP-IF-00247 — 특보 수신 트리거
SAFETYDATA_EMERGENCY_SMS_KEY=
# 통합대피소 DSSP-IF-10941 — 쉼터 4종(한파·무더위·지진옥외·지진해일)
SAFETYDATA_SHELTER_KEY=
# 행정안전부침수흔적도 DSSP-IF-00117 — 과거 사실 문구
SAFETYDATA_FLOOD_TRACE_KEY=
# 지역재해위험지구 DSSP-IF-00058 — 위험구역
SAFETYDATA_HAZARD_ZONE_KEY=
# 침수흔적도_심선 DSSP-IF-20678 — 침수흔적 보강
SAFETYDATA_FLOOD_TRACE_LINE_KEY=

# ── 기상청 API허브 ───────────────────────────────────────
# 데이터셋별이 아니라 계정 단위로 발급되는 키입니다.
# typ02 계열 VilageFcstInfoService_2.0 승인됨, 한도 일 20000회
KMA_APIHUB_KEY=

# ── 국민행동요령 코퍼스 API (safetydata.go.kr, DSSP-IF-20588) ───────────
# 위 재난안전데이터 키들과는 별도로 발급된 서비스키입니다(AI/RAG 담당 신청).
# ⚠️ safety_cate를 생략하면 API가 조용히 태풍(01001)으로 스코프를 좁힙니다 — 항상
#    명시적으로 지정하세요. apps/ai-engine/src/ai_engine/ingestion.py 참고.
SAFETYDATA_ACTION_MANUAL_KEY=

# ── 위치 처리 (카카오맵 역지오코딩) ──────────────────────
KAKAO_REST_API_KEY=

# ── 발송 채널 (웹푸시 / FCM) ─────────────────────────────
# 카카오 알림톡은 예선 범위에서 제외됐습니다(ADR-0005) — 관련 키를 되살리지 마세요.
# FCM Admin SDK 서비스 계정 JSON 경로. 배포 VM에만 존재하며 저장소에 넣지 않습니다.
FCM_SERVICE_ACCOUNT_JSON=

# ── 백엔드 설정 (backend_core.config.Settings — SAVERS_ 접두어 필수) ──
# ⚠️ 접두어 없는 이름으로 두면 코드가 읽지 못하고 조용히 기본값으로 동작합니다.
#    (compose가 서비스 환경변수로 직접 주입하므로 아래 값은 단독 실행용입니다)
SAVERS_AI_ENGINE_URL=http://ai-engine:8100

# ai-engine 호출 타임아웃(초). ⚠️ 8.0은 추정값 — 도달 속도 30초 목표 안에서 실측 후
# 재산정하세요(ADR-0006). 무한 대기는 그 자체로 지표 실패입니다.
SAVERS_AI_ENGINE_TIMEOUT_S=8.0

# 세션 토큰 수명(초). 기본 6시간 — 열람·응답·보호자 재진입은 견디되 유출 링크는 당일 만료.
SAVERS_SESSION_TTL_S=21600

# 푸시 딥링크 오리진(PWA 랜딩). 배포에서는 HTTPS 필수입니다 — 웹푸시는 localhost 외
# HTTPS에서만 동작합니다(ADR-0005). 로컬 기본값이 3000인 이유는 프론트 개발 서버가
# 카카오맵 SDK 허용 도메인 때문에 3000에 고정돼 있기 때문입니다(vite strictPort).
SAVERS_PUBLIC_BASE_URL=http://localhost:3000

# 이 API를 부를 수 있는 브라우저 출처 목록(쉼표 구분). 비우면 동일 출처만 허용합니다.
# 프론트는 정적 호스팅으로 나가고 백엔드는 VM에 남으므로(ADR-0008) 배포에서는 교차 출처가
# 기본 상태이고, 이 값이 비어 있으면 프론트가 배포돼 있어도 API를 못 부릅니다.
# 로컬 개발은 vite 프록시를 쓰므로 비워 두는 것이 정상입니다.
# 예) SAVERS_CORS_ALLOW_ORIGINS=https://savers-project.vercel.app
# ⚠️ 프리뷰 도메인(https://savers-project-git-<브랜치>.vercel.app)은 넣지 마세요.
# 커밋마다 바뀌어 허용 목록이 곧 무의미해집니다(ADR-0008).
SAVERS_CORS_ALLOW_ORIGINS=

# --- TLS 종단 (docker compose --profile tls 로 켤 때만 필요) ---
# Caddy가 인증서를 발급받을 공인 호스트명입니다. 도메인이 없으면 sslip.io로 VM 공인 IP를
# 그대로 호스트명으로 쓸 수 있습니다(점 대신 하이픈). 절차는 docs/공통_가이드/배포_절차.md.
#   예) SAVERS_PUBLIC_HOST=3-35-12-34.sslip.io
# ⚠️ 값이 틀린 채로 띄우면 Let's Encrypt 실패 한도(주당 5회/도메인)를 소모합니다.
SAVERS_PUBLIC_HOST=
