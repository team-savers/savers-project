# infra/.env.example — 실제 값이 아닌 "키 목록" 템플릿입니다. 이 파일만 커밋합니다.
# 사용: cp infra/.env.example infra/.env  후 값 입력 (infra/.env 는 커밋 금지)

# ── 생성 모델 (HyperCLOVA X) ─────────────────────────────
CLOVA_API_KEY=
CLOVA_API_GATEWAY_URL=

# ── 벡터 DB (Chroma) ────────────────────────────────────
CHROMA_PERSIST_DIR=./.chroma

# ── 공공 재난 데이터 Open API ────────────────────────────
# 기상청 / 소방청 / 행정안전부 재난안전데이터 공유 플랫폼
DISASTER_API_KEY=

# ── 위치 처리 (카카오맵 역지오코딩) ──────────────────────
KAKAO_REST_API_KEY=

# ── 발송 채널 (카카오 알림톡) ────────────────────────────
KAKAO_ALIMTALK_SENDER_KEY=
KAKAO_ALIMTALK_API_KEY=

# ── 서비스 간 주소 (docker-compose 기준) ─────────────────
AI_ENGINE_BASE_URL=http://ai-engine:8100
