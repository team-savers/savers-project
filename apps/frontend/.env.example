VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_KAKAO_JS_KEY=
# TMAP 보행자 경로 API 키. 비공개 등급 — 프론트 직접 호출 여부는 미결이며,
# 백엔드 프록시로 확정되면 이 항목은 서버 측 .env 로 옮긴다.
VITE_TMAP_APP_KEY=
# Use the in-memory mock adapter (true) or the real HTTP adapter (false).
# Defaults to true so the app runs without a backend.
VITE_USE_MOCK=true
# Base URL for the real backend. Only consulted when VITE_USE_MOCK=false.
VITE_API_BASE_URL=
# Local-only FCM send bridge. When unset (default) the /ops "테스트 발송"
# button uses the in-memory mock path. Set to the bridge URL only when
# running the loopback bridge locally.
VITE_PUSH_BRIDGE_URL=
# Firestore cross-device store for the surrogate-registration flow. ALL FOUR
# keys must be set to enable the store; if any is empty (the default) the app
# falls back to the in-memory mock and the two-device /join flow is inert.
# These point at a SECOND named Firebase app — the default FCM app above is
# untouched. See apps/frontend/src/api/firestore.ts.
VITE_FS_API_KEY=
VITE_FS_PROJECT_ID=
VITE_FS_AUTH_DOMAIN=
VITE_FS_APP_ID=
# Base origin that the /ops QR encodes (e.g. https://savers-frontend.vercel.app).
# Set this only when the operator screen is served from a host the ward's phone
# cannot reach (e.g. http://localhost:3000 during a local demo) so the QR can
# point at a publicly reachable deployment instead. Leave empty (the default)
# to keep building the QR from the current page origin.
VITE_PUBLIC_BASE_URL=
