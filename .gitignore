# ==========================================
# SAVERS monorepo .gitignore
# Stack: Python(FastAPI/RAG) + Node(PWA) + Jupyter
# ⚠️ 이 저장소는 public 입니다. 시크릿/개인정보 패턴은 임의로 완화하지 마세요.
# ==========================================

# --- 공개 저장소 미업로드 자산 (팀 결정) ---
# 대회 제출 서식과 내부 리서치 자료는 레포 밖(로컬)에서 관리합니다.
# 파일명 접두어 `내부_`는 필터링 실수를 줄이기 위한 규약입니다.
내부_*.md
docs/제출_자료/
docs/참고_자료/
# 공유_문서/는 개정되는 마크다운 전용입니다. 제출 서식 PDF를 경로만 바꿔 두는 우회를
# 막기 위해 이 폴더의 PDF는 확장자로도 차단합니다(docs/제출_자료/ 경로 차단의 백스톱).
docs/공유_문서/*.pdf

# --- Jupyter Notebook & Lab Outputs ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
checkpoint_*.ipynb
.virtual_documents/
.jupyter/
.local/share/jupyter/

# 주의: 노트북 출력 셀(실행 결과)이 diff를 오염시키고 저장소 용량을 키우는 문제는
# .gitignore로 해결되지 않습니다. nbstripout이 .gitattributes filter + pre-commit hook으로
# 구성되어 있으니 `pre-commit install`을 반드시 실행하세요.

# --- JupyterHub Runtime State ---
jupyterhub.sqlite
jupyterhub_cookie_secret
jupyterhub_config.py.bak
.jupyterhub-runtime/
jupyterhub-proxy.pid

# --- Python Build & Runtime ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ⚠️ lib/ · build/ · dist/ 는 **루트 기준으로만** 무시합니다.
#    선행 슬래시가 없으면 모든 깊이에 매칭되어 프론트엔드 소스(SvelteKit/Next의
#    apps/frontend/src/lib/)가 통째로 무시되는 사고가 납니다.
/lib/
/lib64/
/build/
/dist/

# --- Virtual Environments ---
.venv/
venv/
ENV/
/env/
third-party/

# --- Conda ---
.conda/
envs/
conda-meta/
pkgs/
*.tar.bz2

# --- Node / Frontend (apps/frontend) ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.next/
.nuxt/
.svelte-kit/
.turbo/
.parcel-cache/
.vite/
coverage/
*.tsbuildinfo
# 빌드 산출물은 앱 단위로도 무시 (루트 앵커가 잡지 못하는 경로)
apps/*/dist/
apps/*/build/
apps/*/.output/

# --- Environment Variables & Cloud Secrets (Security) ---
.env
.env.*
# ⚠️ 값이 아닌 "키 목록" 템플릿은 커밋해야 합니다 (infra/.env.example).
!.env.example
!.env.*.example
.secrets
*.pem
*.p12
*.pfx
*.key
*.pub
id_rsa*
id_ed25519*

# Cloud Service Account / Credential Files
# *.json 전체를 막지 않고 명명 패턴으로 한정합니다.
*-key.json
*-keyfile.json
*-credentials.json
*sa-key.json
gcp-*.json
service-account*.json
secret_*.json
credentials/

# --- Data & Large Artifacts (Never commit heavy datasets) ---
# ⚠️ 디렉토리는 루트 기준으로만 무시합니다. git은 "제외된 디렉토리" 내부의 예외를
#    복원하지 못하므로, 커밋해야 하는 자산은 반드시 파일 패턴 예외로 두세요.
/data/
/datasets/
/outputs/
*.csv
*.xlsx
*.jsonl
*.parquet
*.h5
*.pickle
*.pkl
*.npy
*.npz
*.sqlite
*.db

# 커밋해야 하는 소형 데이터 예외 (반드시 위 무시 규칙보다 아래에 위치해야 동작)
# 평가 골든셋: 코드와 함께 리뷰·재현되어야 하는 자산입니다 (근거 일치율/환각 억제율 채점용).
!apps/ai-engine/eval/**/*.csv
!apps/ai-engine/eval/**/*.jsonl
# 오프라인 폴백용 사전 캐시·테스트 픽스처: 코드와 함께 배포/실행되어야 합니다.
!apps/**/fixtures/*.csv
!apps/**/fixtures/*.jsonl
# E2E 시나리오 픽스처도 같은 이유로 커밋 대상입니다.
!e2e/**/fixtures/*.csv
!e2e/**/fixtures/*.jsonl

# 평가 하네스 실행 산출물 (run_*.py의 채점 보고서 — 실행할 때마다 새로 생성됨)
# ⚠️ 골든셋(위 예외)과 달리 보고서는 커밋하지 마세요. 제출용 수치는 스크립트를 다시 돌려
#    재현하는 것이 원칙이고, 커밋된 보고서는 코드가 바뀌어도 그대로 남아 거짓말을 합니다.
#    제출물로 첨부할 때는 PR/릴리스 아티팩트로 올리세요.
/apps/ai-engine/eval/reports/

# E2E 실행 산출물 (Playwright 리포트·트레이스·스크린샷 — 재생성 가능, 용량이 큼)
/e2e/test-results/
/e2e/playwright-report/
/e2e/.pytest_cache/

# --- Model Artifacts & Training Logs ---
models/
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.gguf
*.bin
*.tflite
runs/
lightning_logs/
wandb/
mlruns/

# --- Vector DB (Chroma 로컬 영속화) ---
.chroma/
chroma_db/

# --- Coding Agent ---
# AGENTS.md / CLAUDE.md 는 팀 공유 자산으로 커밋합니다.
# 개인별 지침은 홈 디렉토리(~/.claude/CLAUDE.md 등)에 두세요.
.claude/settings.local.json

# --- OS & IDE Specifics ---
.DS_Store
.DS_Store?
._*
.Spotlight-V10
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
